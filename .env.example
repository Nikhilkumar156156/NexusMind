# Environment Configuration Template: NexusMind
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit .env to version control.

# Server & Network Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://nexusmind:nexusmind_secret@localhost:5432/nexusmind_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=false

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379

# AI & LLM Model Provider Credentials
# Primary Foundation Model (Google Gemini 2.0 / 1.5)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Fallback AI Providers (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars
SESSION_SECRET=your_session_encryption_key_min_32_chars
TOKEN_EXPIRY_MINUTES=15

# Knowledge Ingestion & Vector Search Tuning
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
VECTOR_DIMENSION=768
HNSW_EF_SEARCH=64
